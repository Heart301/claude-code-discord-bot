# Discord Bot Token
# Get this from https://discord.com/developers/applications
DISCORD_TOKEN=your_bot_token_here

# Your Discord User ID (bot will only respond to this user)
# Optional: leave unset to let everyone in the channel use the bot
ALLOWED_USER_ID=your_discord_user_id

# Base folder path where Claude Code will operate
# Channel names will be appended to this path
BASE_FOLDER=/Users/your-user-name/repos

# Optional: route specific Discord channels to a different Anthropic API key
# and/or GitHub token (e.g. a Fine-grained Personal Access Token scoped to
# specific repos). <NAME> can be any string; the channel list is shared
# across both token types so you only list channels once per group.
# Each group needs at least one of _ANTHROPIC_API_KEY / _GITHUB_TOKEN set
# (both is fine too). Channels not listed in any group keep using the
# default ANTHROPIC_API_KEY / GITHUB_TOKEN / claude CLI login.
#GROUP1_CHANNELS=a,b,c
#GROUP1_ANTHROPIC_API_KEY=sk-ant-xxxx
#GROUP1_GITHUB_TOKEN=github_pat_xxxx
#GROUP2_CHANNELS=d,e,f
#GROUP2_GITHUB_TOKEN=github_pat_yyyy

# Port for the MCP permission server (optional, default: 3001)
# Claude Code connects to http://localhost:<port>/mcp for tool approvals
#MCP_SERVER_PORT=3001

# Seconds to wait for a Discord approval reaction (optional, default: 30)
#MCP_APPROVAL_TIMEOUT=30

# What to do when an approval times out: allow or deny (optional, default: deny)
#MCP_DEFAULT_ON_TIMEOUT=deny

# Skip the per-tool-call Discord approval flow entirely (optional, default: unset)
# WARNING: this lets anyone who can message the channel run Claude Code with
# no human-in-the-loop approval. Only set this in trusted/sandboxed environments.
#   dangerous => --dangerously-skip-permissions
#   auto      => --permission-mode auto
#   bypass    => --permission-mode bypassPermissions
#CLAUDE_PERMISSION_MODE=dangerous